{
  "version": 1,
  "types": {
    "uint8":  { "size": 1, "signed": false },
    "int16":  { "size": 2, "signed": true },
    "uint16": { "size": 2, "signed": false },
    "uint32": { "size": 4, "signed": false }
  },
  "messages": {
    "MOVE_TO": {
      "id": 1,
      "direction": "client_to_server",
      "description": "Client requests pathfinding movement to a target tile.",
      "fields": [
        { "name": "target_x", "type": "int16" },
        { "name": "target_y", "type": "int16" }
      ]
    },
    "TOGGLE_RUN": {
      "id": 2,
      "direction": "client_to_server",
      "description": "Client toggles walk/run mode.",
      "fields": [
        { "name": "running", "type": "uint8", "comment": "1 = running, 0 = walking" }
      ]
    },
    "TICK_STATE": {
      "id": 10,
      "direction": "server_to_client",
      "description": "Broadcast every tick with positions of all players in the instance.",
      "fields": [
        { "name": "tick_number", "type": "uint32" },
        { "name": "players", "type": "array", "element": {
          "fields": [
            { "name": "player_id", "type": "uint16" },
            { "name": "tile_x", "type": "int16" },
            { "name": "tile_y", "type": "int16" },
            { "name": "flags", "type": "uint8", "comment": "bit 0 = running" }
          ]
        }}
      ]
    },
    "PLAYER_JOIN": {
      "id": 11,
      "direction": "server_to_client",
      "description": "A new player has joined the instance.",
      "fields": [
        { "name": "player_id", "type": "uint16" },
        { "name": "tile_x", "type": "int16" },
        { "name": "tile_y", "type": "int16" }
      ]
    },
    "PLAYER_LEAVE": {
      "id": 12,
      "direction": "server_to_client",
      "description": "A player has left the instance.",
      "fields": [
        { "name": "player_id", "type": "uint16" }
      ]
    },
    "WELCOME": {
      "id": 13,
      "direction": "server_to_client",
      "description": "Sent to the connecting client with their assigned player ID. Player starts in the lobby.",
      "fields": [
        { "name": "player_id", "type": "uint16" }
      ]
    },
    "JOIN_ROOM": {
      "id": 3,
      "direction": "client_to_server",
      "description": "Client requests to join a specific room by ID string.",
      "fields": [
        { "name": "room_id_length", "type": "uint8" },
        { "name": "room_id", "type": "string", "comment": "UTF-8 bytes, length given by room_id_length" }
      ]
    },
    "LEAVE_ROOM": {
      "id": 4,
      "direction": "client_to_server",
      "description": "Client requests to leave their current room and return to the lobby.",
      "fields": []
    },
    "TRANSFER_REQUEST": {
      "id": 5,
      "direction": "client_to_server",
      "description": "Client requests to transfer to an adjacent room via a specific exit direction.",
      "fields": [
        { "name": "direction_length", "type": "uint8" },
        { "name": "direction", "type": "string", "comment": "UTF-8 string: north, south, east, or west" }
      ]
    },
    "ROOM_LIST": {
      "id": 20,
      "direction": "server_to_client",
      "description": "List of all rooms with their player counts, sent on connect and on changes.",
      "fields": [
        { "name": "room_count", "type": "uint8" },
        { "name": "rooms", "type": "array", "element": {
          "fields": [
            { "name": "room_id_length", "type": "uint8" },
            { "name": "room_id", "type": "string" },
            { "name": "player_count", "type": "uint16" },
            { "name": "grid_x", "type": "int8" },
            { "name": "grid_y", "type": "int8" }
          ]
        }}
      ]
    },
    "ROOM_JOINED": {
      "id": 21,
      "direction": "server_to_client",
      "description": "Confirms the player has entered a room, with spawn position and existing players.",
      "fields": [
        { "name": "room_id_length", "type": "uint8" },
        { "name": "room_id", "type": "string" },
        { "name": "spawn_x", "type": "int16" },
        { "name": "spawn_y", "type": "int16" },
        { "name": "player_count", "type": "uint16" },
        { "name": "players", "type": "array", "element": {
          "fields": [
            { "name": "player_id", "type": "uint16" },
            { "name": "tile_x", "type": "int16" },
            { "name": "tile_y", "type": "int16" }
          ]
        }}
      ]
    },
    "ROOM_TRANSFER": {
      "id": 22,
      "direction": "server_to_client",
      "description": "Notifies a player that they are being transferred to another room.",
      "fields": [
        { "name": "dest_room_id_length", "type": "uint8" },
        { "name": "dest_room_id", "type": "string" },
        { "name": "transfer_time_ms", "type": "uint16" }
      ]
    }
  }
}
